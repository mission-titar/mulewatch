.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
*.db
*.db-wal
*.db-shm
# Secrets de déploiement (EC password, clé VPN) — JAMAIS versionnés.
# Seul deploy/.env.example est versionné ; deploy/.env (et tout .env) est ignoré.
.env
deploy/data/*
!deploy/data/.gitkeep
deploy/ed2k/amule/*
!deploy/ed2k/amule/.gitkeep
deploy/ed2k/downloads/incoming/*
!deploy/ed2k/downloads/incoming/.gitkeep
deploy/ed2k/downloads/temp/*
!deploy/ed2k/downloads/temp/.gitkeep
vendor/
# Worktrees créés par EnterWorktree (checkouts liés, hors versionnement)
.claude/worktrees/

# Documentation site build output (zensical)
site/

# Rapports des agents de revue (spec, holistique), jamais versionnés
.reviews/
