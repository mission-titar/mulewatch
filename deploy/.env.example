# Copy to `.env` (gitignored), then fill in. Ports and image tag are written directly in the
# compose files: edit those instead. See docs/install.md.

# Required. Passwords you choose; no `change-me` must remain.
AMULE_EC_PASSWORD=change-me
AMULE_API_PASSWORD=change-me

# Your own uid and gid (`id -u`, `id -g`): the core runs as them, and deploy/data and deploy/ed2k
# stay readable without sudo.
PUID=1000
PGID=1000

# VPN variant (ed2k/vpn.compose.yml) only. The key is required, the rest have defaults.
WIREGUARD_PRIVATE_KEY=change-me
VPN_SERVICE_PROVIDER=protonvpn
SERVER_COUNTRIES=
# Turning it on also turns port-sync on.
VPN_PORT_FORWARDING=off
