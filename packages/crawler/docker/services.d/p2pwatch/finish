#!/bin/sh
# $1 is the exit code, or 256 when a signal killed the crawler.
# A clean exit is /controls/restart asking for one: s6 restarts the crawler alone, amuled keeps
# its sessions. Anything else stops the container, so a bad config is visible instead of looping.
[ "$1" = 0 ] && exit 0

exec s6-svscanctl -t /etc/services.d
